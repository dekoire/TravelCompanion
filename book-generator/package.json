{
  "name": "@abg/root",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test",
    "clean": "tsc --build --clean",
    "serve": "node apps/server/build.mjs && node apps/server/dist/server.mjs",
    "build:server": "node apps/server/build.mjs",
    "build:preview": "node apps/preview/build.mjs",
    "build:demo": "node apps/demo-book/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
